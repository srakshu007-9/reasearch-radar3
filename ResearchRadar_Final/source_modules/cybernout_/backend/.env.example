
# ResearchHub Environment Configuration
# Copy this file to .env and fill in your actual values

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=researchhub

# =====================================================
# FLASK CONFIGURATION
# =====================================================
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key

# =====================================================
# SCRAPER API CONFIGURATION (optional)
# =====================================================
ARXIV_API_URL=https://export.arxiv.org/api/query
SEARCH_QUERY=all:*
MAX_RESULTS=1000
PAGE_SIZE=100

OPENALEX_API_URL=https://api.openalex.org/works
OPENALEX_API_KEY=
OPENALEX_MAX_RECORDS=30000
OPENALEX_PER_PAGE=100

CROSSREF_API_URL=https://api.crossref.org/works
CROSSREF_MAILTO=your_email@example.com
CROSSREF_MAX_RECORDS=30000
CROSSREF_PER_PAGE=1000

PUBMED_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_API_KEY=
PUBMED_EMAIL=your_email@example.com
PUBMED_MAX_RECORDS=30000
PUBMED_BATCH_SIZE=300

